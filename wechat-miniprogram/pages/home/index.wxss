.page {
  min-height: 100vh;
  padding: 48rpx 32rpx;
}

.hero {
  margin-bottom: 32rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 600;
  color: #111827;
}

.subtitle {
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #4b5563;
}

.card {
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.label {
  font-size: 24rpx;
  color: #6b7280;
}

.value {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #111827;
}
