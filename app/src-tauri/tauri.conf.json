{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "可视化教学",
  "version": "0.1.0",
  "identifier": "com.zhcchen.easy-teaching",
  "build": {
    "beforeDevCommand": "npm --prefix ../web-app run dev",
    "beforeBuildCommand": "npm --prefix ../web-app run build",
    "devUrl": "http://127.0.0.1:57001",
    "frontendDist": "../../web-app/build/client"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "可视化教学",
        "width": 1480,
        "height": 960,
        "minWidth": 1200,
        "minHeight": 760,
        "resizable": true,
        "maximized": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
